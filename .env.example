HTTP_PORT=8080

# 存储后端：memory 或 sqlite
STORAGE_BACKEND=memory
SQLITE_PATH=./data/moetcha.db

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# CAPTCHA 基础
CAPTCHA_TTL=2m
CAPTCHA_MAX_ATTEMPTS=3

# IP 相关策略
CAPTCHA_IP_ENABLED=false
CAPTCHA_IP_REQUIRE_MATCH=true
CAPTCHA_IP_MAX_ACTIVE=0

# UA 相关策略
CAPTCHA_REQUIRE_UA=false
CAPTCHA_REQUIRE_SAME_UA=true

# 验证强度
CAPTCHA_DELETE_ON_FAILED=false
CAPTCHA_MAX_ATTEMPTS_IP=0
CAPTCHA_MAX_ATTEMPTS_IP_WINDOW=0
CAPTCHA_MIN_VERIFY_INTERVAL=0

# 失败率控制
CAPTCHA_MAX_FAIL_RATIO=0
CAPTCHA_FAIL_RATIO_WINDOW=0

# Token 签名与绑定
CAPTCHA_TOKEN_ENABLED=false
CAPTCHA_TOKEN_TTL=90s
CAPTCHA_TOKEN_SINGLE_USE=true
CAPTCHA_TOKEN_BIND_IP=true
CAPTCHA_TOKEN_BIND_UA=true
CAPTCHA_TOKEN_BIND_SESSION=true
CAPTCHA_TOKEN_BIND_IP_PREFIX=24
CAPTCHA_TOKEN_SIGNING_KEY=
CAPTCHA_TOKEN_SIGNING_KEY_NEXT=
CAPTCHA_TOKEN_ROTATION_GRACE=0

# 限流
CAPTCHA_RATE_LIMIT_ENABLED=false
CAPTCHA_RATE_LIMIT_IP_QPS=0
CAPTCHA_RATE_LIMIT_IP_BURST=0
CAPTCHA_RATE_LIMIT_UA_QPS=0
CAPTCHA_RATE_LIMIT_UA_BURST=0
CAPTCHA_RATE_LIMIT_BLOCK_TTL=0
CAPTCHA_RATE_LIMIT_SOFT_REJECT=false
