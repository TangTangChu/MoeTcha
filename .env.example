# MoeTcha 配置文件
# 本文件由 `moetcha config template` 生成，请勿手工调整结构。
# 优先级：命令行 > 真实环境变量 > 本文件 > 默认值。

# ==== 服务 ====

# HTTP 监听端口
HTTP_PORT=8080

# ==== 存储 ====

# 存储后端：memory 或 sqlite
# 可选值：memory / sqlite
STORAGE_BACKEND=memory

# SQLite 数据库文件路径，STORAGE_BACKEND=sqlite 时生效
SQLITE_PATH=./data/moetcha.db

# ==== 日志 ====

# 日志级别
# 可选值：debug / info / warn / error
LOG_LEVEL=info

# ==== CORS 跨域 ====

# 是否启用 CORS 跨域响应头（浏览器端调用必需）
CORS_ENABLED=true

# 允许的跨域来源列表（逗号分隔），* 表示放行任意来源
CORS_ALLOWED_ORIGINS=*

# ==== CAPTCHA 基础 ====

# 验证码难度
# 可选值：easy / medium / hard
CAPTCHA_DIFFICULTY=easy

# 验证码有效期
CAPTCHA_TTL=2m

# 单个验证码允许的最大尝试次数
CAPTCHA_MAX_ATTEMPTS=3

# ==== IP 相关策略 ====

# 是否启用 IP 策略
CAPTCHA_IP_ENABLED=false

# 校验时是否要求 IP 与签发时一致
CAPTCHA_IP_REQUIRE_MATCH=true

# 单 IP 同时存活的验证码上限，0 表示不限制
CAPTCHA_IP_MAX_ACTIVE=0

# ==== UA 相关策略 ====

# 是否要求请求携带 User-Agent
CAPTCHA_REQUIRE_UA=false

# 校验时是否要求 User-Agent 与签发时一致
CAPTCHA_REQUIRE_SAME_UA=true

# ==== 验证强度 ====

# 验证失败后是否立即销毁会话
CAPTCHA_DELETE_ON_FAILED=false

# 单 IP 在窗口期内的最大尝试次数，0 表示不限制
CAPTCHA_MAX_ATTEMPTS_IP=0

# 上述尝试次数的统计窗口，0 表示不限制
CAPTCHA_MAX_ATTEMPTS_IP_WINDOW=0

# 两次校验之间的最小间隔，0 表示不限制
CAPTCHA_MIN_VERIFY_INTERVAL=0

# ==== 失败率控制 ====

# 允许的最大失败率（0~1），0 表示不限制
CAPTCHA_MAX_FAIL_RATIO=0

# 失败率的统计窗口，0 表示不限制
CAPTCHA_FAIL_RATIO_WINDOW=0

# ==== Token 签名与绑定 ====

# 是否签发校验通过后的 Token
CAPTCHA_TOKEN_ENABLED=false

# Token 有效期
CAPTCHA_TOKEN_TTL=90s

# Token 是否一次性使用
CAPTCHA_TOKEN_SINGLE_USE=true

# Token 是否绑定 IP
CAPTCHA_TOKEN_BIND_IP=true

# Token 是否绑定 User-Agent
CAPTCHA_TOKEN_BIND_UA=true

# Token 是否绑定会话 ID
CAPTCHA_TOKEN_BIND_SESSION=true

# 绑定 IP 时使用的前缀长度
CAPTCHA_TOKEN_BIND_IP_PREFIX=24

# Token 签名密钥，启用 Token 时必填（可用 moetcha gen-key 生成）
CAPTCHA_TOKEN_SIGNING_KEY=

# 轮换中的下一个签名密钥，留空表示不轮换
CAPTCHA_TOKEN_SIGNING_KEY_NEXT=

# 密钥轮换的宽限期，0 表示不启用
CAPTCHA_TOKEN_ROTATION_GRACE=0

# ==== 限流 ====

# 是否启用限流
CAPTCHA_RATE_LIMIT_ENABLED=false

# 单 IP 每秒请求数上限，0 表示不限制
CAPTCHA_RATE_LIMIT_IP_QPS=0

# 单 IP 的突发容量，0 表示不限制
CAPTCHA_RATE_LIMIT_IP_BURST=0

# 单 UA 每秒请求数上限，0 表示不限制
CAPTCHA_RATE_LIMIT_UA_QPS=0

# 单 UA 的突发容量，0 表示不限制
CAPTCHA_RATE_LIMIT_UA_BURST=0

# 触发限流后的封禁时长，0 表示不封禁
CAPTCHA_RATE_LIMIT_BLOCK_TTL=0

# 限流时是否软拒绝（返回提示而非直接断开）
CAPTCHA_RATE_LIMIT_SOFT_REJECT=false

# ==== 接口鉴权与资源限制 ====

# 逗号分隔的 API Token 列表，为空时 /grid/generate 等内部接口保持开放（仅适合内网/本地开发）；配置后客户端需带 Authorization: Bearer <token> 或 X-API-Token: <token>
API_TOKENS=

# /grid/generate 同时渲染的并发上限，0 表示按 CPU 核数
GRID_GENERATE_CONCURRENCY=0

# 单张源图解码后的像素数上限，超过则拒绝（防止内存放大）。0 表示默认 16000000
MAX_SOURCE_IMAGE_PIXELS=0

# /grid/generate 合成图的 libwebp effort（0=最快，6=最慢/质量最高）。
# 0=自动：小图用 4、中图用 2、大图用 1，避免大网格在高质量档下编码耗时几秒。
# 觉得合成图偏慢可设 1 或 2；追求极致质量可设 4~6。
GRID_WEBP_METHOD=0

# ==== 图像渲染 ====

# 是否对验证码图片叠加随机噪声（抗 OCR）。默认关闭，产出干净高质量图；需要干扰时再开启
RENDER_NOISE_ENABLED=false

# 噪声密度（0~0.2），仅在 RENDER_NOISE_ENABLED=true 时生效。0 等同关闭
RENDER_NOISE_DENSITY=0.02

# 噪声随机种子，0 表示每张图随机（推荐）。非零值会产生固定噪声图样，仅用于调试/复现
RENDER_NOISE_SEED=0

# /challenge 响应图的 WebP 编码质量（1~100）。0 表示默认 80。调高可提升清晰度但增大体积
RENDER_QUALITY=80
