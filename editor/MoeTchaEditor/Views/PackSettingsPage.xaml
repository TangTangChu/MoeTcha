<Page
    x:Class="MoeTchaEditor.Views.PackSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalContentAlignment="Stretch"
                  Background="Transparent">
        <StackPanel Padding="32,24,40,36"
                    Spacing="32"
                    MaxWidth="980"
                    HorizontalAlignment="Left">
            <TextBlock Text="素材包设置"
                       Style="{StaticResource EditorPageTitleStyle}"/>

            <!-- 基本信息 -->
            <StackPanel Spacing="16">
                <TextBlock Text="基本信息"
                           Style="{StaticResource EditorSectionTitleStyle}"/>

                <TextBox Header="包名 (pack_name)"
                         Text="{x:Bind VM.PackName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="例如：GalGame 角色包"/>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Header="作者 (author)"
                             Text="{x:Bind VM.Pack.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="例如：糖糖毬"/>
                    <TextBox Grid.Column="1"
                             Header="版本 (version)"
                             Text="{x:Bind VM.Pack.Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="例如：1.0"/>
                </Grid>

                <TextBox Header="描述 (description)"
                         Text="{x:Bind VM.Pack.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         MinHeight="96"
                         TextWrapping="Wrap"
                         PlaceholderText="简单描述这个素材包的内容"/>
            </StackPanel>

            <!-- Grid 挑战 -->
            <StackPanel Spacing="16">
                <TextBlock Text="Grid 挑战"
                           Style="{StaticResource EditorSectionTitleStyle}"/>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <NumberBox Header="图片数 (size)"
                               Value="{x:Bind VM.Pack.Grid.Size, Mode=TwoWay}"
                               Minimum="4"
                               Maximum="36"
                               SpinButtonPlacementMode="Compact"
                               ValueChanged="GridSizeChanged"/>
                    <NumberBox Grid.Column="1"
                               Header="最少正确数"
                               Value="{x:Bind VM.Pack.Grid.CorrectMin, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="35"
                               SpinButtonPlacementMode="Compact"
                               ValueChanged="CorrectMinChanged"/>
                    <NumberBox Grid.Column="2"
                               Header="最多正确数"
                               Value="{x:Bind VM.Pack.Grid.CorrectMax, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="35"
                               SpinButtonPlacementMode="Compact"
                               ValueChanged="CorrectMaxChanged"/>
                </Grid>

                <TextBox Header="问题模板 (question) · {tag} 会替换成标签显示名"
                         Text="{x:Bind VM.Pack.Grid.Question, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Click 挑战 -->
            <StackPanel Spacing="16">
                <TextBlock Text="Click 挑战"
                           Style="{StaticResource EditorSectionTitleStyle}"/>

                <TextBox Header="问题模板 (question) · {tag} 会替换成标签显示名"
                         Text="{x:Bind VM.Pack.Click.Question, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
