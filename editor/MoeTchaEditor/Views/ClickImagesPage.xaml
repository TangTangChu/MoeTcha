<Page
    x:Class="MoeTchaEditor.Views.ClickImagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MoeTchaEditor.Models"
    xmlns:vm="using:MoeTchaEditor.ViewModels">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Background="Transparent"
                    Padding="20,0,8,0"
                    DefaultLabelPosition="Right">
            <CommandBar.Content>
                <TextBlock Text="Click 图片"
                           Style="{StaticResource EditorPageTitleStyle}"/>
            </CommandBar.Content>
            <AppBarButton Icon="Add"
                          Label="导入图片"
                          Command="{x:Bind VM.ImportClickImageCommand}"/>
        </CommandBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel: image list -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Padding="20,14,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="图片列表"
                               Style="{StaticResource EditorSectionTitleStyle}"/>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind VM.ClickImageDisplays.Count, Mode=OneWay}"/>
                        <Run Text=" 张"/>
                    </TextBlock>
                </Grid>

                <ListView Grid.Row="1"
                          Padding="8,0,8,12"
                          Background="Transparent"
                          ItemsSource="{x:Bind VM.ClickImageDisplays, Mode=OneWay}"
                          SelectedItem="{x:Bind VM.SelectedClickImage, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ClickImageDisplay">
                            <Grid Padding="5,4"
                                  ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="48"
                                        Height="48"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <Image Source="{x:Bind Thumbnail}"
                                           Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind FileName}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind FileName}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Right panel: image editor -->
            <Grid Grid.Column="2">
                <!-- Editor with selected image -->
                <Grid Visibility="{x:Bind VM.HasSelectedClickImage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Region editing header -->
                    <Grid Padding="24,12"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource EditorSectionTitleStyle}">
                                <Run Text="区域编辑 · "/>
                                <Run Text="{Binding SelectedClickImage.FileName}"
                                     FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock Text="在图片上拖拽鼠标画出矩形区域"
                                       Style="{StaticResource EditorPageDescriptionStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="清除全部"
                                Click="ClearAll"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </Grid>

                    <!-- Canvas + region list -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <!-- Image canvas -->
                        <Grid Margin="16"
                              MinHeight="260"
                              Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Grid x:Name="RegionCanvas"
                                  Background="Transparent"
                                  SizeChanged="OnCanvasSizeChanged"
                                  PointerPressed="CanvasPressed"
                                  PointerReleased="CanvasReleased"
                                  PointerCanceled="CanvasPointerCanceled"
                                  PointerCaptureLost="CanvasPointerCanceled">
                                <Image x:Name="Preview"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Source="{Binding SelectedClickImage.Thumbnail}"
                                       ImageOpened="OnImageOpened"
                                       ImageFailed="OnImageFailed"/>
                                <Canvas x:Name="Overlay"
                                        Background="Transparent"/>
                            </Grid>
                        </Grid>

                        <!-- Region list -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Padding="16,14,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="区域列表"
                                           Style="{StaticResource EditorSectionTitleStyle}"/>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{Binding SelectedClickImage.Source.Regions.Count}"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl Margin="16,0,12,16"
                                              ItemsSource="{Binding SelectedClickImage.Source.Regions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:RegionInfo">
                                            <Grid Padding="0,10"
                                                  RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                        <Run Text="x "/><Run Text="{x:Bind X, Mode=OneTime}"/>
                                                        <Run Text="  y "/><Run Text="{x:Bind Y, Mode=OneTime}"/>
                                                        <Run Text="  w "/><Run Text="{x:Bind Width, Mode=OneTime}"/>
                                                        <Run Text="  h "/><Run Text="{x:Bind Height, Mode=OneTime}"/>
                                                    </TextBlock>
                                                    <Button Grid.Column="1"
                                                            Content="删除"
                                                            Tag="{x:Bind}"
                                                            Click="DeleteRegion"
                                                            FontSize="11"
                                                            Padding="8,3"
                                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                </Grid>

                                                <AutoSuggestBox Grid.Row="1"
                                                         Text="{x:Bind Tag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="区域标签"
                                                         FontSize="12"
                                                         Loaded="RegionTagBoxLoaded"
                                                         TextChanged="RegionTagBoxTextChanged"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Empty state: no image selected -->
                <Grid Padding="32"
                      Visibility="{x:Bind VM.HasSelectedClickImage, Mode=OneWay, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="6">
                        <FontIcon Glyph="&#xE7C9;"
                                  FontSize="28"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="选择一张 Click 图片"
                                   Style="{StaticResource EditorSectionTitleStyle}"/>
                        <TextBlock Text="从左侧列表选择图片，或使用命令栏导入"
                                   Style="{StaticResource EditorPageDescriptionStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
