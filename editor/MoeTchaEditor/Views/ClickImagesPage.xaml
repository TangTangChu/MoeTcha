<Page
    x:Class="MoeTchaEditor.Views.ClickImagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MoeTchaEditor.Models"
    xmlns:vm="using:MoeTchaEditor.ViewModels"
    xmlns:controls="using:MoeTchaEditor.Controls">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Background="Transparent"
                    Padding="20,0,8,0"
                    DefaultLabelPosition="Right">
            <CommandBar.Content>
                <TextBlock Text="Click 图片"
                           Style="{StaticResource EditorPageTitleStyle}"/>
            </CommandBar.Content>
            <AppBarButton Icon="Add"
                          Label="导入图片"
                          Command="{x:Bind VM.ImportClickImageCommand}"/>
        </CommandBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel: image list -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Padding="20,14,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="图片列表"
                               Style="{StaticResource EditorSectionTitleStyle}"/>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind VM.ClickImageDisplays.Count, Mode=OneWay}"/>
                        <Run Text=" 张"/>
                    </TextBlock>
                </Grid>

                <ListView Grid.Row="1"
                          Padding="8,0,8,12"
                          Background="Transparent"
                          ItemsSource="{x:Bind VM.ClickImageDisplays, Mode=OneWay}"
                          SelectedItem="{x:Bind VM.SelectedClickImage, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ClickImageDisplay">
                            <Grid Padding="5,4"
                                  ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="48"
                                        Height="48"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <Image Source="{x:Bind Thumbnail}"
                                           Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind FileName}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind FileName}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Right panel: image editor -->
            <Grid Grid.Column="2">
                <!-- Editor with selected image -->
                <Grid Visibility="{x:Bind VM.HasSelectedClickImage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Region editing header -->
                    <Grid Padding="24,10"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource EditorSectionTitleStyle}">
                                <Run Text="区域编辑 · "/>
                                <Run Text="{Binding SelectedClickImage.FileName}"
                                     FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock x:Name="ActiveTagHint"
                                       Style="{StaticResource EditorPageDescriptionStyle}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="清除全部"
                                Click="ClearAll"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </Grid>

                    <!-- Canvas + region list -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- Image canvas -->
                        <Grid Margin="16"
                              MinHeight="260"
                              Background="{ThemeResource ControlFillColorSecondaryBrush}"
                              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="4">
                            <Grid x:Name="RegionCanvas"
                                  Background="Transparent"
                                  SizeChanged="OnCanvasSizeChanged"
                                  PointerPressed="CanvasPressed"
                                  PointerMoved="CanvasMoved"
                                  PointerReleased="CanvasReleased"
                                  PointerCanceled="CanvasPointerCanceled"
                                  PointerCaptureLost="CanvasPointerCanceled">
                                <Image x:Name="Preview"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Source="{Binding SelectedClickImage.Thumbnail}"
                                       ImageOpened="OnImageOpened"
                                       ImageFailed="OnImageFailed"/>
                                <Canvas x:Name="Overlay"
                                        Background="Transparent"/>
                            </Grid>
                        </Grid>

                        <!-- Tag-grouped region list -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Padding="16,14,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="标签分组"
                                           Style="{StaticResource EditorSectionTitleStyle}"/>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind RegionCount, Mode=OneWay}"/>
                                    <Run Text=" 个区域"/>
                                </TextBlock>
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Disabled"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="12,0,10,12">
                                <ItemsControl ItemsSource="{x:Bind RegionGroups, Mode=OneWay}"
                                              HorizontalContentAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RegionGroup">
                                            <Border Margin="0,0,0,8"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    BorderThickness="1"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                <StackPanel Spacing="6">
                                                    <!-- Group header: dot + tag + count + draw-target toggle -->
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="10"
                                                                 Height="10"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{x:Bind Color, Mode=OneWay}"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{x:Bind DisplayTag, Mode=OneWay}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTipService.ToolTip="{x:Bind DisplayTag, Mode=OneWay}"/>
                                                        <Border Grid.Column="2"
                                                                CornerRadius="9"
                                                                Padding="7,1"
                                                                VerticalAlignment="Center"
                                                                Background="{x:Bind Color, Mode=OneWay}">
                                                            <TextBlock Text="{x:Bind Count, Mode=OneWay}"
                                                                       FontSize="11"
                                                                       Foreground="White"/>
                                                        </Border>
                                                        <ToggleButton Grid.Column="3"
                                                                      Padding="6,1"
                                                                      MinWidth="0"
                                                                      FontSize="11"
                                                                      IsChecked="{x:Bind IsActive, Mode=TwoWay}"
                                                                      Click="ToggleActiveGroup"
                                                                      ToolTipService.ToolTip="设为绘制目标：新建区域自动归入此标签"
                                                                      Content="绘制"/>
                                                    </Grid>

                                                    <!-- Region rows -->
                                                    <ItemsControl ItemsSource="{x:Bind Rows}"
                                                                  HorizontalContentAlignment="Stretch">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:RegionRow">
                                                                <Grid ColumnSpacing="6"
                                                                      Padding="3,3"
                                                                      Tag="{x:Bind Source}"
                                                                      Tapped="SelectRegion">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Rectangle Width="3"
                                                                               RadiusX="1.5"
                                                                               RadiusY="1.5"
                                                                               Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                                               Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                                        <controls:TagEditor MaxTags="1"
                                                                                            Tags="{x:Bind Tags, Mode=TwoWay}"
                                                                                            PlaceholderText="标签"/>
                                                                        <TextBlock Text="{x:Bind Coords, Mode=OneWay}"
                                                                                   FontSize="10"
                                                                                   FontFamily="Consolas"
                                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="2"
                                                                            Tag="{x:Bind Source}"
                                                                            Click="DeleteRegion"
                                                                            FontSize="11"
                                                                            Padding="8,2"
                                                                            MinWidth="0"
                                                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                            Content="删"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Empty state: no image selected -->
                <Grid Padding="32"
                      Visibility="{x:Bind VM.HasSelectedClickImage, Mode=OneWay, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="6">
                        <FontIcon Glyph="&#xE7C9;"
                                  FontSize="28"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="选择一张 Click 图片"
                                   Style="{StaticResource EditorSectionTitleStyle}"/>
                        <TextBlock Text="从左侧列表选择图片，或使用命令栏导入"
                                   Style="{StaticResource EditorPageDescriptionStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
