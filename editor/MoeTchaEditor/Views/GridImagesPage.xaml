<Page
    x:Class="MoeTchaEditor.Views.GridImagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MoeTchaEditor.ViewModels"
    xmlns:views="using:MoeTchaEditor.Views">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Background="Transparent"
                    Padding="20,0,8,0"
                    DefaultLabelPosition="Right">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Grid 图片"
                               Style="{StaticResource EditorPageTitleStyle}"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="共 "/>
                        <Run Text="{x:Bind VM.GridImageDisplays.Count, Mode=OneWay}"
                             FontWeight="SemiBold"/>
                        <Run Text=" 张"/>
                    </TextBlock>
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton Icon="Add"
                          Label="导入并裁剪"
                          Click="ImportClick"/>
        </CommandBar>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsRepeater ItemsSource="{x:Bind VM.GridImageDisplays, Mode=OneWay}"
                           Margin="20,18,12,20">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="220"
                                       MinItemHeight="340"
                                       MinRowSpacing="14"
                                       MinColumnSpacing="14"
                                       Orientation="Horizontal"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:GridImageDisplay">
                        <Grid MaxWidth="280"
                              RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="170"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Image Source="{x:Bind Thumbnail}"
                                       Stretch="Uniform"/>
                            </Border>

                            <TextBlock Grid.Row="1"
                                       Text="{x:Bind FileName}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind FileName}"/>

                            <AutoSuggestBox Grid.Row="2"
                                            Text="{x:Bind Source.TagsStr, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            PlaceholderText="输入标签（选择建议自动追加）"
                                            Loaded="TagBoxLoaded"
                                            TextChanged="TagBoxTextChanged"
                                            SuggestionChosen="TagBoxSuggestionChosen"/>

                            <Grid Grid.Row="3"
                                  ColumnSpacing="8"
                                  Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="重新取景"
                                        Tag="{x:Bind}"
                                        Click="CropClick"/>
                                <Button Grid.Column="1"
                                        Content="移除"
                                        Tag="{x:Bind}"
                                        Click="DeleteClick"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <views:CropOverlay x:Name="CropOverlay"
                           Visibility="Collapsed"
                           Canvas.ZIndex="100"/>
    </Grid>
</Page>
