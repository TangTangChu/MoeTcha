<UserControl
    x:Class="MoeTchaEditor.Views.CropOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#B8000000" Padding="32">
        <Border MaxWidth="1120" MaxHeight="820" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Padding="22,18" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="调整 Grid 图片取景" Style="{StaticResource EditorSectionTitleStyle}"/>
                        <TextBlock x:Name="CropFileName" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="拖动绿色方框移动取景区域"
                               VerticalAlignment="Center" Style="{StaticResource EditorPageDescriptionStyle}"/>
                </Grid>

                <Border Grid.Row="1" Margin="20,0" Background="#FF181818"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Image x:Name="Preview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                               ImageOpened="OnImageOpened" ImageFailed="OnImageFailed"/>
                        <Canvas x:Name="OverlayCanvas" Background="Transparent" SizeChanged="OnLayoutChanged"
                                PointerPressed="OverlayPressed" PointerMoved="OverlayMoved" PointerReleased="OverlayReleased"
                                PointerCanceled="OverlayPointerCanceled" PointerCaptureLost="OverlayPointerCanceled"
                                PointerWheelChanged="OverlayWheel"/>
                    </Grid>
                </Border>

                <Grid Padding="22,16" Margin="0,18,0,0"
                      Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Text="裁剪大小"/>
                            <Slider x:Name="SizeSlider" Minimum="10" Maximum="100" Value="100"
                                    Width="260" ValueChanged="OnSizeChanged"/>
                            <TextBlock x:Name="SizeLabel" VerticalAlignment="Center" MinWidth="72"
                                       TextAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Button x:Name="SkipBtn" Content="跳过此图" Click="OnSkip"/>
                            <Button x:Name="ConfirmBtn" Content="确认裁剪" Click="OnConfirm"
                                    Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
